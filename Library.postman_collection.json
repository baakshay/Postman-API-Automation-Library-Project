	"item": [
		{
			"name": "AddBook",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const jsonData = pm.response.json();\r",
							"pm.test(\"Verify stutus code is 200\", ()=>{\r",
							"    pm.response.to.have.status(200);\r",
							"    pm.expect(jsonData).to.have.property(\"Msg\");\r",
							"});\r",
							"pm.test(\"Header cookies responsetime validation\",()=>{\r",
							"    pm.response.to.have.header(\"Content-Type\");\r",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\t\"application/json;charset=UTF-8\");\r",
							"    pm.expect(pm.response.responseTime).to.be.below(1200);\r",
							"    pm.expect(pm.response.text()).to.include(\"successfully added\");\r",
							"})\r",
							"pm.test(\"Header cookies responstime validation\",()=>{\r",
							"    pm.response.to.have.header(\"Content-Type\");\r",
							"    pm.expect(pm.response.responseTime).to.be.below(1000)\r",
							"    pm.expect(pm.response.text()).to.include(\"successfully\")\r",
							"})\r",
							"\r",
							"console.log(jsonData);\r",
							"const book_id = jsonData.ID;\r",
							"console.log(book_id);\r",
							"pm.environment.set(\"book_id\", book_id);\r",
							"\r",
							"//isbn and aisle - lets concatinate = \r",
							"pm.test(\"ID logic validation\",()=>{\r",
							"    const isbn_val = pm.collectionVariables.get(\"isbn\");\r",
							"    const req = JSON.parse(pm.request.body.raw);\r",
							"    const aisle_val = req.aisle;\r",
							"    const expected_id = isbn_val + aisle_val;\r",
							"    pm.expect(book_id).to.eql(expected_id);\r",
							"});\r",
							"\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"//RS23243  isbs + aisle logic = ID\r",
							"console.log(pm.globals.get(\"companyCode\"));\r",
							"const code = pm.globals.get(\"companyCode\");\r",
							"const val = pm.variables.replaceIn('{{$randomInt}}');\r",
							"pm.collectionVariables.set(\"isbn\", code+val);\r",
							"\r",
							"//get and set auther name dynamically\r",
							"// pm.collectionVariables.set(\"author_name\", \"Rahul Shetty\");\r",
							"\r",
							"\r",
							"//Data driven testing - using pm.iterationData this is use for stress testing when hundreds of data tested \r",
							"pm.collectionVariables.set(\"book_name\", pm.iterationData.get(\"BookName\"));\r",
							"console.log(pm.collectionVariables.get(\"book_name\"));\r",
							"pm.collectionVariables.set(\"author_name\",pm.iterationData.get(\"Author\"));\r",
							"console.log(pm.collectionVariables.get(\"author_name\"));"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"protocolProfileBehavior": {
				"disableBodyPruning": true
			},
			"request": {
				"method": "GET",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n\"name\":\"Learn Appium Automation with Java\",\r\n\"isbn\":\"{{isbn}}\",\r\n\"aisle\":\"227\",\r\n\"author\":\"{{author_name}}\"\r\n}\r\n",
					"options": {
